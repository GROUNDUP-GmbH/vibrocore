# Copy to .env and fill in. .env is gitignored. Do not commit secrets.
# JSON-RPC accepts ODOO_API_KEY (non-interactive). The file upload
# POST /plm_document_upload/login is an interactive session and needs
# ODOO_PASSWORD. Set both when the API key must not be the account password.
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
ODOO_PASSWORD=
