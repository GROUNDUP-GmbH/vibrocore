    <inputs>
      <input x="272" y="108" rotation="0" font="Liberation Sans,12,-1,5,50,0,0,0,0,0" text="G1" />
      <input x="272" y="128" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Mean Well SDR-120-24" />
      <input x="272" y="144" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="VC-PW-5310" />
      <input x="272" y="608" rotation="0" font="Liberation Sans,12,-1,5,50,0,0,0,0,0" text="G2" />
      <input x="272" y="628" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="OPEN 24 V supply" />
      <input x="272" y="644" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="VC-PW-5320" />
      <input x="480" y="1334" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Notes" />
      <input x="480" y="1354" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(1) The general 24 V rail is 2.5 mm2. The" />
      <input x="480" y="1370" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="S200 24 V feed is 1.0 mm2. There is no 48" />
      <input x="480" y="1386" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="V rail." />
      <input x="480" y="1402" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(2) G2 is an open 24 V slot. SDR-480-24 is" />
      <input x="480" y="1418" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="the slot size, not a purchase." />
      <input x="480" y="1434" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(3) Both 0 V rails meet at X1 pin 4. W1 is" />
      <input x="480" y="1450" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="the only bond to PE. Confirm W1 in the" />
