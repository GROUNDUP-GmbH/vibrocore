      <input x="519" y="108" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="600_W  0.75 mm2" />
      <input x="726" y="438" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="622_WB  1.5 mm2" />
      <input x="508" y="138" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="102_PE  6 mm2" />
      <input x="600" y="752" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Notes" />
      <input x="600" y="768" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(1) Motor B swaps V and W at X3 so the motors turn in opposite" />
      <input x="600" y="782" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="directions." />
      <input x="600" y="796" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(2) X3 pin 2 is cabinet W on motor V. X3 pin 3 is cabinet V on motor" />
      <input x="600" y="810" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="W." />
      <input x="600" y="824" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(3) OPEN: F22 needs a PWM-rated protector. Do not fit a standard" />
      <input x="600" y="838" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="GV2." />
      <input x="600" y="852" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(4) The motor cable stays 4G1.5 shielded at the drive." />
    </inputs>
