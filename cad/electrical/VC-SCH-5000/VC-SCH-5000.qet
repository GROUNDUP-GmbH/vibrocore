      <input x="48" y="48" rotation="0" font="Liberation Sans,12,-1,5,50,0,0,0,0,0" text="A6  Nanotec PD2-C4118  VC-CT-6280  proposal, not released" />
      <input x="480" y="982" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Notes" />
      <input x="480" y="1002" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(1) Nanotec PD2-C4118L1804-E-01 is a" />
      <input x="480" y="1018" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="proposal. It speaks USB, not Modbus." />
      <input x="480" y="1034" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(2) Clock and direction come from U2. U2" />
      <input x="480" y="1050" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="is not a DIO pin. Enable is DIO output 7." />
      <input x="480" y="1066" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(3) CLK- and DIR- are parked on 0 V at X9." />
      <input x="480" y="1082" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Do not land them on b5 or b7." />
      <input x="480" y="1098" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(4) 24 V is inside the 12 V to 48 V range." />
      <input x="480" y="1114" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="The fuse is 2 A. The wire is 0.75 mm2." />
      <input x="84" y="154" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="211_24C  1.0 mm2" />
      <input x="480" y="232" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="500_24R  0.75 mm2" />
      <input x="448" y="374" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="495_ROT_EN  0.75 mm2" />
      <input x="456" y="512" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="530_CLKP  0.75 mm2" />
      <input x="456" y="612" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="532_DIRP  0.75 mm2" />
      <input x="176" y="861" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="001_0V  2.5 mm2" />
