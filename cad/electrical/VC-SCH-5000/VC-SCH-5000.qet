      <input x="480" y="1138" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(1) The drive STO screw is one terminal." />
      <input x="480" y="1154" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="DI3 is the second channel. The SoMove" />
