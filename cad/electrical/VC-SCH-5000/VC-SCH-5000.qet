      <input x="480" y="682" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="LAN. Assume 0.5 m." />
      <input x="480" y="698" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(3) Modbus slave 1 is the ATV320. Slave 2" />
      <input x="480" y="714" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="is the S200. Baud and parity are TODO." />
      <input x="480" y="730" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(4) The rotation drive is not on this bus." />
