  <titleblocktemplates>
    <titleblocktemplate name="vc">
      <information />
      <logos />
      <grid rows="24;24;" cols="t28%;r44%;t28%;">
        <field name="author" row="0" col="0" align="left" valign="center" displaylabel="true" fontsize="12" hadjust="true">
