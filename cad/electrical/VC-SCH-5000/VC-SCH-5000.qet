      <input x="772" y="88" rotation="0" font="Liberation Sans,12,-1,5,50,0,0,0,0,0" text="K1" />
      <input x="772" y="108" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Pilz PNOZ s4" />
      <input x="772" y="124" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="750104" />
      <input x="772" y="140" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="VC-CT-6220" />
      <input x="60" y="368" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="S1" />
      <input x="480" y="1462" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Notes" />
      <input x="480" y="1482" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(1) Two NC channels go to the PNOZ s4," />
      <input x="480" y="1498" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="article 750104. The third NC is DIO input" />
      <input x="480" y="1514" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="index 2 only." />
      <input x="480" y="1530" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(2) Do not feed cabinet 24 V into S11 or" />
      <input x="480" y="1546" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="S21. The PNOZ makes the test pulses." />
      <input x="480" y="1562" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(3) The reset sits between S12 and S34." />
      <input x="480" y="1578" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Set a monitored reset. The detent text is" />
      <input x="480" y="1594" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="TBC." />
      <input x="480" y="1610" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(4) OPEN: the E-stop contact block and the" />
      <input x="480" y="1626" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="reset button are not chosen." />
