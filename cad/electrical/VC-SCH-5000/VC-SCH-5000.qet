      <input x="48" y="108" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="W-MAINS   VC-PW-5600   Instagrid   X1   3G6 mm2, 15.7 A   shield no   PE is 6 mm2." />
      <input x="48" y="136" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="W-SON-A   VC-SH-1700   X2   M2   4G1.5 mm2 shielded, 1.45 A   shield yes   Straight phases. Shield at the drive." />
      <input x="48" y="164" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="W-SON-B   VC-SH-1700   X3   M3   4G1.5 mm2 shielded, 1.45 A   shield yes   V and W are swapped at X3." />
      <input x="48" y="192" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="W-HUB-P   VC-HB-3440   X4 and X6   M1   4G1.5 mm2 shielded plus 2x0.75 mm2 brake   shield no   Siemens order code is TODO." />
      <input x="48" y="220" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="W-HUB-E   VC-HB-3450   X5   M1 encoder   Catalogue encoder cable   shield no   Siemens order code is TODO." />
      <input x="48" y="248" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="W-STO   VC-CT-6730   K1   A2 and A3   2x0.75 mm2 per channel   shield no   Do not mix the two channels in one pair." />
      <input x="48" y="276" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="W-IO   VC-CT-6740   X7 and X8   Field devices   0.75 mm2   shield part   24 V field feed is 1.0 mm2." />
      <input x="48" y="304" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="W-ETH   VC-CT-6750   A4 ETH0   A7 LAN   Cat5e patch   shield no   Length assumed 0.5 m." />
      <input x="48" y="332" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="W-485   VC-CT-6760   A4   A3 then A2   Shielded pair 0.75 mm2   shield no   120 ohm at the S200. Shield to PE at the RevPi only." />
      <input x="48" y="360" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="W-ROT   VC-CT-6770   X9   A6   0.75 mm2   shield yes   Proposal. Not on the live BOM." />
      <input x="48" y="388" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="W-TILT   VC-CT-6740   X8   M4   1.5 mm2 power TBC, 0.75 mm2 limits   shield no   Actuator current is not confirmed." />
      <input x="48" y="416" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="W-LIFT   VC-LT-9120   X10 and X7   M5 and M6   Section TBC   shield no   Nameplate current is not known." />
      <input x="48" y="444" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="W-GNSS   VC-CT-6500   Head   Receiver   Antenna cable   shield yes   Runs in VC-HB-3430." />
      <input x="48" y="472" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="W-CHAIN   VC-HB-3430   Frame   Carriage   igus 2400.05.075.0   shield yes   Bend radius 75 mm. Length for 1300 mm stroke is TODO." />
