      <input x="600" y="768" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(1) Instagrid ONE max is the only AC source. Continuous current is" />
      <input x="600" y="782" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="15.7 A." />
      <input x="600" y="796" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(2) Q1 does not switch PE. QF1 is type B, 30 mA. The dashed line is" />
      <input x="600" y="810" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="the mechanical link." />
      <input x="600" y="824" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(3) F4 feeds the S200 supply. F5 feeds the general 24 V supply. Both" />
      <input x="600" y="838" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="continue on folio 03." />
      <input x="600" y="852" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(4) A crossing without a dot is not a connection." />
    </inputs>
