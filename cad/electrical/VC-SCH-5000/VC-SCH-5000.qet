    <inputs>
      <input x="292" y="88" rotation="0" font="Liberation Sans,12,-1,5,50,0,0,0,0,0" text="F2" />
      <input x="292" y="108" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Schneider GV2L20" />
      <input x="292" y="124" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="VC-PW-5730" />
      <input x="480" y="838" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Notes" />
      <input x="480" y="858" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(1) F2 is a Schneider GV2L20. NVE41289.09," />
      <input x="480" y="874" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="enclosure, 240 V, one phase. Pole 3 is" />
      <input x="480" y="890" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="open." />
      <input x="480" y="906" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(2) The row is ATV320U15M2. Line current" />
      <input x="480" y="922" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="is 17.8 A at 200 V. Irm is 223 A." />
      <input x="480" y="938" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(3) The sonic feeder is 6 mm2. The S200" />
      <input x="480" y="954" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="feeder is 2.5 mm2." />
      <input x="480" y="970" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(4) The dashed line is the mechanical link" />
      <input x="480" y="986" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="of one device." />
