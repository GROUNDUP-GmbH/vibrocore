      <input x="50" y="12" rotation="0" font="Liberation Sans,12,-1,5,50,0,0,0,0,0" text="A3 output, motor B. V and W are swapped at X3." />
      <input x="179" y="108" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="600_U  0.75 mm2" />
