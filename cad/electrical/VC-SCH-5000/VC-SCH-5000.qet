      <input x="480" y="1306" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(2) Do not land 24 V on STO-VS. X130 is" />
      <input x="480" y="1322" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="not on this PTI drive." />
      <input x="480" y="1338" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(3) STO status is status word bit STO_EP." />
      <input x="480" y="1354" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Do not land 440_S200FB on a connector." />
