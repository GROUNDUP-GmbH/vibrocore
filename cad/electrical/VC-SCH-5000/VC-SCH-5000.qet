      <input x="480" y="618" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(1) RUT241 runs from the general 24 V" />
      <input x="480" y="634" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="rail. There is no 9 V converter and no PE" />
      <input x="480" y="650" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="screw." />
