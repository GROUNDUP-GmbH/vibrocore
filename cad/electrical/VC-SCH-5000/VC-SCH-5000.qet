  <diagram titleblocktemplate="vc" titleblocktemplateCollection="embedded" cols="16" rows="16" colsize="72" rowsize="64" height="1024" folio="%id/%total" title="Notes" author="Ground UP GmbH" filename="VC-SCH-5000" date="2026-11-20" indexrev="0D" displaycols="true" displayrows="true" displayAt="bottom" order="21" version="0.100">
    <defaultconductor type="single" condsize="1" numsize="10" displaytext="0" conductor_color="#000000" text_color="#000000" horizontal-alignment="AlignBottom" vertical-alignment="AlignRight" function="" num="" formula="" conductor_section="" tension_protocol="" onetextperfolio="0" cable="" bus="" bicolor="false" dash-size="2" color2="#000000" horizrotatetext="0" vertirotatetext="0" />
    <elements />
    <conductors />
    <shapes>
      <shape type="Rectangle" x1="470" y1="862" x2="1136" y2="1012" closed="1" rx="0" ry="0" z="1" is_movable="1" antialias="false">
        <pen color="#000080" widthF="1" style="SolidLine" />
        <brush color="#ffffff" style="NoBrush" />
      </shape>
    </shapes>
    <inputs>
      <input x="48" y="48" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="This folio holds the points that do not sit in a folio notes field." />
      <input x="48" y="70" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="OPEN: the E-stop contact block VC-CT-6210 is not chosen." />
      <input x="48" y="92" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="OPEN: the reset button VC-CT-6270 is not chosen." />
      <input x="48" y="114" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="OPEN: the index sensor VC-CT-6250 is not chosen. The output is PNP." />
      <input x="48" y="136" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="OPEN: F21 and F22 have no PWM-rated order code." />
      <input x="48" y="158" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="TBC: S200 X131 STO-VS and STO-M. Do not land 24 V on STO-VS." />
      <input x="48" y="180" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="TBC: 440_S200FB is STO_EP and is not landed on a connector." />
      <input x="48" y="202" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="TBC: ATV320 RJ45 pin numbers, manual NVE41308. DI3 SoMove parameter is TODO." />
      <input x="48" y="224" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="TBC: RevPi X4 order and the RS-485 printed order." />
      <input x="48" y="246" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="TBC: W1 is the only 0 V to PE bond. Remove it if the S200 PTI manual forbids it." />
      <input x="48" y="268" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="The Instagrid source is 15.7 A continuous. The drive rated input is 17.8 A at 200 V." />
      <input x="48" y="290" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="The drive does not run at rated input on this source." />
      <input x="48" y="312" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="The Nanotec rotation drive is a proposal and is not on Modbus." />
      <input x="48" y="334" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Tilt actuator current and the lift cable section are TBC." />
      <input x="48" y="356" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="No new price is sourced." />
      <input x="48" y="398" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Folio 08 note (4) continues: X124 screws are marked 24 V and 0 V. Both" />
      <input x="48" y="416" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="screws of one mark are one node." />
      <input x="48" y="440" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Folio 08 note (5) continues: VC-HB-3450 is the catalogue encoder" />
      <input x="48" y="458" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="cable. The Siemens order code is TODO." />
      <input x="48" y="482" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Folio 08 note (6) continues: U1 is not a DIO pin. Pulse form and scale" />
      <input x="48" y="500" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="are TBC." />
      <input x="48" y="524" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Folio 08 note (7) continues: Encoder map, drive to motor: 7 A, 8 B, 4" />
      <input x="48" y="542" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="C, 5 D, 1 E, 2 F." />
      <input x="48" y="566" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Folio 08 note (8) continues: R1 is 120 ohm at the S200. The shield" />
      <input x="48" y="584" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="lands on PE at the RevPi only." />
      <input x="48" y="608" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Folio 08 note (9) continues: X5 pin 2 is the shield. Land the shield" />
      <input x="48" y="626" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="at one end only." />
      <input x="48" y="650" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Folio 11 note (4) continues: RJ45 pin numbers are TBC. See the Modbus" />
      <input x="48" y="668" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="manual NVE41308." />
      <input x="48" y="692" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Folio 15 note (4) continues: The actuator current is not on a" />
      <input x="48" y="710" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="nameplate. The power section is TBC. Pin 14 is open." />
      <input x="480" y="868" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Notes" />
    </inputs>
  </diagram>
