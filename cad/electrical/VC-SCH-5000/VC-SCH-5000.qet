      <input x="40" y="180" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="W-HUB-P   VC-HB-3440   X4 and X6   M1   4G1.5 mm2 shielded plus 2x0.75 mm2 brake   shield no   Siemens order code is TODO." />
      <input x="40" y="208" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="W-HUB-E   VC-HB-3450   X5   M1 encoder   Catalogue encoder cable   shield no   Siemens order code is TODO." />
