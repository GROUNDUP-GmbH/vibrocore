      <input x="600" y="768" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(1) One ATV320 output feeds both OLI MVE 400/6-HF motors. Each motor" />
      <input x="600" y="782" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="is 1.45 A." />
      <input x="600" y="796" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(2) Motor A keeps the drive phase order." />
      <input x="600" y="810" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(3) OPEN: F21 needs a PWM-rated protector. Do not fit a standard" />
