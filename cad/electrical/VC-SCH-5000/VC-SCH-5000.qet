    <inputs>
      <input x="40" y="40" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="This folio holds the points that do not sit in a folio notes field." />
      <input x="40" y="68" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="OPEN: the E-stop contact block VC-CT-6210 is not chosen." />
      <input x="40" y="96" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="OPEN: the reset button VC-CT-6270 is not chosen." />
      <input x="40" y="124" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="OPEN: the index sensor VC-CT-6250 is not chosen. The output is PNP." />
      <input x="40" y="152" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="OPEN: F21 and F22 have no PWM-rated order code." />
