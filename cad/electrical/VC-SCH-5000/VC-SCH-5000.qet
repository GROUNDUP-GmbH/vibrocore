            <translation lang="en">%folio</translation>
          </value>
          <label>
            <translation lang="en">Folio</translation>
          </label>
        </field>
        <field name="file" row="1" col="0" align="left" valign="center" displaylabel="true" fontsize="12" hadjust="true">
          <value>
            <translation lang="en">%filename</translation>
          </value>
          <label>
            <translation lang="en">File</translation>
          </label>
        </field>
        <field name="date" row="1" col="1" align="center" valign="center" displaylabel="true" fontsize="12" hadjust="true">
          <value>
            <translation lang="en">2026-11-20</translation>
          </value>
          <label>
            <translation lang="en">Date</translation>
          </label>
        </field>
        <field name="rev" row="1" col="2" align="left" valign="center" displaylabel="true" fontsize="12" hadjust="true">
          <value>
            <translation lang="en">%indexrev</translation>
          </value>
          <label>
            <translation lang="en">Rev</translation>
          </label>
        </field>
      </grid>
    </titleblocktemplate>
  </titleblocktemplates>
