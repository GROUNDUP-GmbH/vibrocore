      <input x="480" y="854" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Notes" />
      <input x="480" y="874" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(1) One ATV320 output feeds both OLI MVE" />
      <input x="480" y="890" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="400/6-HF motors. Each motor is 1.45 A." />
      <input x="480" y="906" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(2) Motor A keeps the drive phase order." />
      <input x="480" y="922" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(3) OPEN: F21 needs a PWM-rated protector." />
      <input x="480" y="938" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Do not fit a standard GV2." />
      <input x="480" y="954" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(4) Supply wire is 6 mm2. 600_U, 600_V and" />
      <input x="480" y="970" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="600_W are the drive-to-F21 run at 1.5 mm2," />
      <input x="480" y="986" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="the same section as the 4G1.5 motor cable." />
