      <input x="48" y="840" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="X9.1    500_24R    +24    Proposal. Not released. 0.75 mm2" />
      <input x="48" y="860" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="X9.2    001_0V    0V    Proposal. 2.5 mm2" />
      <input x="48" y="880" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="X9.3    495_ROT_EN    ENA    DIO output 7 to +Release. 0.75 mm2" />
