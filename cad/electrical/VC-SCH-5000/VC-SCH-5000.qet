    <inputs>
      <input x="232" y="88" rotation="0" font="Liberation Sans,12,-1,5,50,0,0,0,0,0" text="A3" />
      <input x="232" y="108" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="ATV320 output" />
      <input x="232" y="124" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="motor B" />
      <input x="612" y="108" rotation="0" font="Liberation Sans,12,-1,5,50,0,0,0,0,0" text="F22" />
      <input x="612" y="128" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="VC-PW-5770" />
      <input x="1032" y="128" rotation="0" font="Liberation Sans,12,-1,5,50,0,0,0,0,0" text="M3" />
      <input x="1032" y="148" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="MVE 400" />
      <input x="1032" y="164" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="VC-SH-1100" />
      <input x="480" y="854" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Notes" />
      <input x="480" y="874" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(1) Motor B swaps V and W at X3 so the" />
      <input x="480" y="890" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="motors turn in opposite directions." />
      <input x="480" y="906" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(2) X3 pin 2 is cabinet W on motor V. X3" />
      <input x="480" y="922" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="pin 3 is cabinet V on motor W." />
      <input x="480" y="938" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(3) OPEN: F22 needs a PWM-rated protector." />
      <input x="480" y="954" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="Do not fit a standard GV2." />
      <input x="480" y="970" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="(4) The motor cable stays 4G1.5 shielded" />
      <input x="480" y="986" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="at the drive." />
      <input x="428" y="152" rotation="0" font="Liberation Sans,10,-1,5,50,0,0,0,0,0" text="600_U  1.5 mm2" />
