# Copy to .env on the controller. Never commit .env.
# Generate Node-RED password hash (on a trusted host with bcryptjs):
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 8))" 'YOUR_PASSWORD'

NODE_RED_USERNAME=admin
NODE_RED_PASSWORD_HASH=
NODE_RED_CREDENTIAL_SECRET=

# Mosquitto user used by Node-RED (must match mosquitto/passwd)
MQTT_USERNAME=vibrocore
MQTT_PASSWORD=
